{
  "manifest_version": 3,
  "name": "Auto Cookie Rejector",
  "version": "1.0",
  "description": "Automatically rejects cookie consent banners when possible.",

  "action": {
    "default_title": "Auto Cookie Rejector"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation"
  ],

  "background": {
    "service_worker": "sw.js"
  },

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
